{
  "hooks": {
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "python3 \"$PLUGIN_ROOT/context_handoff.py\" post-tool", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "python3 \"$PLUGIN_ROOT/context_handoff.py\" stop", "timeout": 10 }] }
    ],
    "PreCompact": [
      { "matcher": "manual", "hooks": [{ "type": "command", "command": "python3 \"$PLUGIN_ROOT/context_handoff.py\" pre-compact", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3 \"$PLUGIN_ROOT/context_handoff.py\" prompt", "timeout": 10 }] }
    ],
    "SessionStart": [
      { "matcher": "compact", "hooks": [{ "type": "command", "command": "python3 \"$PLUGIN_ROOT/context_handoff.py\" session-start", "timeout": 10 }] }
    ]
  }
}
